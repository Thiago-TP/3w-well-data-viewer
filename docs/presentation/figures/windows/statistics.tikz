% Every statistic's separation of event windows from normal ones at 512
% samples, a dot per well in the color the viewer's pages give it, a bar at
% the median over the wells; at the right, how many wells the statistic is the
% best in. The statistics, by the short names the table beside the chart
% gives them, are grouped by what they read of a window: its level, its
% spread, its shape. The CSV tables beside this file are written by
% scripts/windows.py: statistics.csv (a row per dot: the statistic's row, the
% separation, the well's color, whether few) and medians.csv (a row per
% statistic: its names, group, median and wins). A well resting on fewer than
% \wiFew windows of a kind is set apart, a hollow dot, as the appendix sets its
% line apart. The wells without an event window have no separation, so no dot.
\begin{tikzpicture}
  \begin{axis}[
    scale only axis, width=48mm, height=46mm,
    xmin=-0.04, xmax=1.04, ymin=-0.6, ymax=11.6, y dir=reverse,
    xtick={0,0.5,1}, xticklabels={0,0.5,1}, ytick={0,...,11},
    yticklabels from table={figures/windows/medians.csv}{short},
    tick label style={font=\tiny, text=ws3wbrown}, y tick label style={text=ws3wnavy},
    tick style={draw=none},
    axis x line*=bottom, axis y line*=left, x axis line style={draw=ws3wgrey},
    y axis line style={draw=none},
    ymajorgrids, grid style={draw=ws3wgrey!50, line width=.2pt},
    xlabel={Separation},
    xlabel style={font=\tiny, text=ws3wbrown, yshift=1.5mm},
    clip=false,
  ]
    % The groups apart: the levels (rows 0 to 5), the spread (6), the shapes.
    % (Written out: pgfplots draws at the end of the axis, after a loop's
    % variable is gone.)
    \draw [ws3wbrown!50, line width=.3pt] (axis cs:-0.04,5.5) -- (axis cs:1.3,5.5);
    \draw [ws3wbrown!50, line width=.3pt] (axis cs:-0.04,6.5) -- (axis cs:1.3,6.5);
    \node [font=\tiny\itshape, text=ws3wbrown, anchor=west] at (axis cs:1.2,2.5) {level};
    \node [font=\tiny\itshape, text=ws3wbrown, anchor=west] at (axis cs:1.2,6) {spread};
    \node [font=\tiny\itshape, text=ws3wbrown, anchor=west] at (axis cs:1.2,9) {shape};
    % One well: a dot in its color, read off the table (palette.well_colors),
    % hollow when it rests on fewer than \wiFew windows of a kind.
    \addplot [only marks, scatter, mark=*, mark size=1pt,
              visualization depends on={value \thisrow{color} \as \wicolor},
              visualization depends on={value \thisrow{few} \as \wifewdot},
              scatter/@pre marker code/.code={%
                \definecolor{wiwell}{HTML}{\wicolor}%
                \ifnum\wifewdot=1
                  \tikzset{wi mark/.style={fill=white, draw=wiwell, line width=.4pt}}%
                \else
                  \tikzset{wi mark/.style={fill=wiwell, draw=white, line width=.15pt}}%
                \fi
                \scope[wi mark]},
              scatter/@post marker code/.code={\endscope}]
      table [x=separation, y=row] {figures/windows/statistics.csv};
    % The median over the wells: a bar across the row.
    \addplot [only marks, mark=|, mark size=2.6pt, mark options={line width=.9pt}, ws3wnavy]
      table [x=median, y=row] {figures/windows/medians.csv};
    % How many wells each statistic is the best in.
    \addplot [draw=none, nodes near coords, point meta=explicit symbolic,
              nodes near coords style={font=\tiny, text=ws3wnavy, anchor=center}]
      table [x expr=1.11, y=row, meta=wins] {figures/windows/medians.csv};
    \node [font=\tiny, text=ws3wbrown, anchor=south] at (axis cs:1.11,-0.6) {best};
  \end{axis}
\end{tikzpicture}
